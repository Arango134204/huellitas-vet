{
  "info": {
    "name": "HuellitasVet API",
    "description": "Colección con scripts pm.test. Flujo Angular (manual): dashboard → crear/editar dueño y mascota → subir foto → agendar/editar cita → atender. Si la API está caída, las peticiones fallan por red (evidencia de dependencia del backend).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3900" },
    { "key": "duenoId", "value": "" },
    { "key": "mascotaId", "value": "" },
    { "key": "citaId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Servidor",
      "item": [
        {
          "name": "GET Servidor OK",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Servidor OK', () => pm.expect(pm.response.json().message).to.eql('Servidor OK'));"
          ]}}],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" }
        },
        {
          "name": "API caída (documentar fallo de red)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Si API caída no hay 200', function () {",
            "  if (pm.response.code) { pm.expect(pm.response.code).to.not.eql(200); }",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:3999/",
            "description": "Puerto incorrecto a propósito. Debe fallar la conexión: evidencia de que el panel depende de la API."
          }
        }
      ]
    },
    {
      "name": "02 Dueños",
      "item": [
        {
          "name": "Listar dueños",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "pm.test('Trae duenos', () => pm.expect(d.duenos).to.be.an('array'));",
            "if (d.duenos && d.duenos[0]) pm.collectionVariables.set('duenoId', d.duenos[0]._id);"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/duenos" }
        },
        {
          "name": "Crear dueño inválido",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Lu\",\n  \"documento\": \"1\",\n  \"telefono\": \"12\",\n  \"email\": \"malo\"\n}" },
            "url": "{{baseUrl}}/api/dueno/save"
          }
        },
        {
          "name": "Eliminar dueño con mascotas",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409 integridad', () => pm.response.to.have.status(409));"
          ]}}],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/dueno/{{duenoId}}" }
        }
      ]
    },
    {
      "name": "03 Mascotas",
      "item": [
        {
          "name": "Listar mascotas",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "if (d.mascotas && d.mascotas[0]) pm.collectionVariables.set('mascotaId', d.mascotas[0]._id);"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/mascotas" }
        },
        {
          "name": "Editar mascota dueño inexistente",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 dueño', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Test\",\n  \"especie\": \"perro\",\n  \"dueno\": \"6afc43ed28192ba51a723500\"\n}" },
            "url": "{{baseUrl}}/api/mascota/{{mascotaId}}"
          }
        },
        {
          "name": "Eliminar mascota con historial",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409 historial', () => pm.response.to.have.status(409));"
          ]}}],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/mascota/{{mascotaId}}" }
        },
        {
          "name": "Subir imagen válida",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 imagen', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "imagen", "type": "file", "src": "", "description": "Seleccione un PNG/JPG real ≤ 2MB" }]
            },
            "url": "{{baseUrl}}/api/mascota/upload-image/{{mascotaId}}"
          }
        },
        {
          "name": "Subir archivo no imagen (extensión .png falsa)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Rechaza contenido o MIME', () => pm.expect([400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "imagen", "type": "file", "src": "", "description": "Suba un .txt renombrado a .png para probar magic bytes" }]
            },
            "url": "{{baseUrl}}/api/mascota/upload-image/{{mascotaId}}"
          }
        }
      ]
    },
    {
      "name": "04 Citas (reglas)",
      "item": [
        {
          "name": "Resumen",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tiene resumen', () => pm.expect(pm.response.json().resumen).to.be.an('object'));"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/citas/resumen" }
        },
        {
          "name": "Listar pendientes",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "if (d.citas && d.citas[0]) pm.collectionVariables.set('citaId', d.citas[0]._id);"
          ]}}],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/citas?estado=pendiente" }
        },
        {
          "name": "Agendar en el pasado",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 pasado', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mascota\": \"{{mascotaId}}\",\n  \"fecha\": \"2020-01-01T10:00:00\",\n  \"motivo\": \"Prueba pasado\",\n  \"veterinario\": \"Dra. Salazar\"\n}" },
            "url": "{{baseUrl}}/api/cita/save"
          }
        },
        {
          "name": "Editar cita a fecha pasada (PUT)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 en update', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"2020-01-01T10:00:00\",\n  \"veterinario\": \"Dra. Salazar\",\n  \"motivo\": \"Intento edición inválida\"\n}" },
            "url": "{{baseUrl}}/api/cita/{{citaId}}"
          }
        },
        {
          "name": "Transición inválida atendida→pendiente",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409 transición', () => pm.expect([409,400]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"pendiente\"\n}" },
            "url": "{{baseUrl}}/api/cita/{{citaId}}/estado",
            "description": "Primero marque la cita como atendida; luego ejecute este request para ver 409."
          }
        }
      ]
    }
  ]
}
